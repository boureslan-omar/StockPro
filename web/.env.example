NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Authenticates Vercel Cron requests to /api/cron/*. Generate any random string
# and set the same value in Vercel's project environment variables — Vercel
# automatically sends it as "Authorization: Bearer <value>" on cron requests.
CRON_SECRET=
